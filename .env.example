# CATIA environment variables (copy to .env and fill as needed)
# Optional: used for real data and tuning. Omit or leave blank for defaults.

# External APIs (optional; without these, mock data is used)
# NOAA_API_TOKEN=your_noaa_cdo_token

# Data cache
# CATIA_CACHE_DIR=data/cache
# CATIA_CACHE_TTL=86400

# Simulation
# CATIA_N_JOBS=-1

# Model registry
# CATIA_MODEL_REGISTRY=models/registry.json

# Logging
# CATIA_LOG_LEVEL=INFO
# CATIA_STRUCTURED_LOGS=0

# Observability
# CATIA_METRICS=0

# Optional features
# CATIA_USE_ENSEMBLE=0
# CATIA_USE_DL=0
# CATIA_USE_SHAP=0

# Severity distribution: Lognormal | Pareto | Weibull | Gamma | Spliced
# CATIA_SEVERITY_DIST=Lognormal
