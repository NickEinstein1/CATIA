# Copy to .env and adjust. Docker Compose reads these when using `env_file:` locally.

# Optional: full public URL for “Copy shareable link” on Live Earth (no trailing slash).
# CATIA_PUBLIC_DASH_URL=http://127.0.0.1:8050

# Live feed refresh (ms) for the dashboard interval component.
# CATIA_LIVE_REFRESH_MS=180000

# Persistent cache for merged live feeds (disk under outputs/ or Redis).
# CATIA_LIVE_DISK_CACHE=1
# CATIA_CACHE_DIR=/app/outputs/.catia_cache

# Redis URL enables Redis cache backend when redis package is installed (`pip install catia[cache]`).
# CATIA_REDIS_URL=redis://127.0.0.1:6379/0

# Demo / air-gapped: no HTTP fetches.
# CATIA_LIVE_OFFLINE=0

# Disable GDACS leg of the merge (USGS + EONET still run).
# CATIA_LIVE_FETCH_GDACS=1

# Deck.gl indicative exposure polygons under scatter points.
# CATIA_EXPOSURE_OVERLAY=1

# MapLibre basemap token name for deckgl-dash (see package docs).
# CATIA_DECK_MAP_STYLE=CARTO_DARK_MATTER
